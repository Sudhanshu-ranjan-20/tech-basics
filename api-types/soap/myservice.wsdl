<?xml version="1.0" encoding="utf-8"?>
<definitions name="MessageSplitterService"
    targetNamespace="http://example.com"
    xmlns:tns="http://example.com"
    xmlns:soap="http://xmlsoap.org"
    xmlns:xsd="http://w3.org"
    xmlns="http://xmlsoap.org">

    <types>
        <xsd:schema targetNamespace="http://example.com">
            <xsd:element name="SplitRequest">
                <xsd:complexType>
                    <xsd:sequence>
                        <xsd:element name="message" type="xsd:string"/>
                        <xsd:element name="splitter" type="xsd:string"/>
                    </xsd:sequence>
                </xsd:complexType>
            </xsd:element>
            <xsd:element name="SplitResponse">
                <xsd:complexType>
                    <xsd:sequence>
                        <xsd:element name="result" type="xsd:string" maxOccurs="unbounded"/>
                    </xsd:sequence>
                </xsd:complexType>
            </xsd:element>
        </xsd:schema>
    </types>

    <message name="SplitInput">
        <part name="body" element="tns:SplitRequest"/>
    </message>
    <message name="SplitOutput">
        <part name="body" element="tns:SplitResponse"/>
    </message>

    <portType name="SplitterPortType">
        <operation name="MessageSplitter">
            <input message="tns:SplitInput"/>
            <output message="tns:SplitOutput"/>
        </operation>
    </portType>

    <binding name="SplitterBinding" type="tns:SplitterPortType">
        <soap:binding style="document" transport="http://xmlsoap.org"/>
        <operation name="MessageSplitter">
            <soap:operation soapAction="http://example.com/MessageSplitter"/>
            <input><soap:body use="literal"/></input>
            <output><soap:body use="literal"/></output>
        </operation>
    </binding>

    <service name="MessageSplitterService">
        <port name="SplitterPort" binding="tns:SplitterBinding">
            <soap:address location="http://localhost:8000/wsdl"/>
        </port>
    </service>
</definitions>
